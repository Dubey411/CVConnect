generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String?
  name                String
  refreshToken        String?
  resumes             Resume[]
  jobs                Job[]
  platformConnections PlatformConnection[]
  jobApplications     JobApplication[]
  browserSessions     BrowserSession[]
  automationRules     AutomationRule[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   @default("General") // "Full Stack", "Data", "ML", "General"
  title       String?  // e.g. "FullStack_Resume.pdf"
  original    Json
  optimized   Json?
  sourceUrl   String?
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  matchScore  Float?
  atsScore    Float?
  analysis    Json?
  skillGap    Json?
  status      String   @default("completed")
  version     Int      @default(1)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([matchScore])
}

model Job {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  company      String?
  description  String   @db.Text
  skills       Json
  requirements Json
  resumes      Resume[]
  applications JobApplication[]
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model PlatformConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          String
  accountEmail      String
  encryptedToken    String
  iv                String
  authTag           String
  status            String    @default("connected")
  applicationsCount Int       @default(0)
  tokenExpiresAt    DateTime?                     // populated for JWT platforms (Unstop)
  lastVerifiedAt   DateTime?                     // timestamp of last live API verification
  lastSyncAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model JobApplication {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  platform     String
  status       String   @default("pending")
  targetUrl    String?
  errorDetails String?  @db.Text
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([platform, status])
}

model BrowserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  profilePath  String                          // absolute path to the Playwright user-data-dir
  status       String    @default("pending")   // pending | connecting | connected | expired | failed
  accountEmail String?
  connectedAt  DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model AutomationRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String
  dailyLimit   Int      @default(25)
  targetRole   String   @default("Data Engineer")
  resumeId     String?  // Mapped category resume for auto-apply
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

